<Text>
<![CDATA[[EQU(\System.RecipeActive.Mold1.MoldNumber,Intralox_MoldNumber[2]) MOV(Mold1_Recipe_4INT_Pallet_Pos,Init_station_positions[4]) MOV(Init_station_positions[4],stations_array[4].position) ,[EQU(\System.RecipeActive.Mold1.MoldNumber,Intralox_MoldNumber[1]) ,EQU(\System.RecipeActive.Mold1.MoldNumber,Intralox_MoldNumber[3]) ] MOV(Mold1_Recipe_6INT_Pallet_Pos,Init_station_positions[4]) MOV(Init_station_positions[4],stations_array[4].position) ,EQU(\System.RecipeActive.Mold1.MoldNumber,Intralox_MoldNumber[4]) MOV(Mold1_Recipe_45FE_Pallet_Pos,Init_station_positions[4]) MOV(Init_station_positions[4],stations_array[4].position) ,EQU(\System.RecipeActive.Mold1.MoldNumber,Intralox_MoldNumber[5]) MOV(Mold1_Recipe_65FE_Pallet_Pos,Init_station_positions[4]) MOV(Init_station_positions[4],stations_array[4].position) ];]]>
