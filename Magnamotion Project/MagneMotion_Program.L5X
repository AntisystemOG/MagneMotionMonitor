<Routine Name="init_stations" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(1,s);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQU(MM_Global_Velocity,MM_Global_Velocity)EQU(MM_Global_Acc,MM_Global_Acc)NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Init Stations is called by the cold start service to initialize everything in the stations_array
Setup for For Routine #1 (initializes a station entry) and loop through all stations 1 to max_station_id and initialize each entry]]>
</Comment>
<Text>
<![CDATA[LBL(loop1)[MMI_Init_station(MIS_AOI,stations_array[s],0,0,0,0,0.0,0.0,MMI_DIRECTION_FORWARD,0) MOV(1,stations_array[s].state) MOV(0,stations_array[s].active_vehicle_id) OTU(stations_array[s].station_hold_flag) ,LES(s,max_station_id) ADD(s,1,s) JMP(loop1) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(Init_Dwell,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[-----------------------------------------------
HOME STATION
-----------------------------------------------
]]>
</Comment>
<Text>
<![CDATA[MMI_Init_station(MIS_AOI,stations_array[33],3,Init_station_positions[33],stationDwell[33],30,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[-----------------------------------------------
CLEANOUT STATION
-----------------------------------------------
]]>
</Comment>
<Text>
<![CDATA[MMI_Init_station(MIS_AOI,stations_array[34],5,Init_station_positions[34],stationDwell[34],0,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[-----------------------------------------------
MOLD CHECK STATION
DETERMINES WHICH MOLD DIRECTION FOR THE PALLET
-----------------------------------------------
]]>
</Comment>
<Text>
<![CDATA[MMI_Init_station(MIS_AOI,stations_array[30],6,Init_station_positions[30],stationDwell[30],1,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[---------------------------------------------------
Pre-Mold  & Mold Stations 1& 2 
---------------------------------------------------
]]>
</Comment>
<Text>
<![CDATA[[MMI_Init_station(MIS_AOI,stations_array[1],2,Init_station_positions[1],stationDwell[1],2,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,0) MMI_Init_station(MIS_AOI,stations_array[2],2,Init_station_positions[2],stationDwell[2],3,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,1) MMI_Init_station(MIS_AOI,stations_array[3],2,Init_station_positions[3],stationDwell[3],13,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,1) MMI_Init_station(MIS_AOI,stations_array[4],2,Init_station_positions[4],stationDwell[4],13,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2) MMI_Init_station(MIS_AOI,stations_array[5],2,Init_station_positions[5],stationDwell[5],6,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2) MMI_Init_station(MIS_AOI,stations_array[6],2,Init_station_positions[6],stationDwell[6],13,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2) ,MMI_Init_station(MIS_AOI,stations_array[7],4,Init_station_positions[7],0,8,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,0) MMI_Init_station(MIS_AOI,stations_array[8],4,Init_station_positions[8],0,13,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,1) MMI_Init_station(MIS_AOI,stations_array[9],4,Init_station_positions[9],0,13,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,1) MMI_Init_station(MIS_AOI,stations_array[10],4,Init_station_positions[10],stationDwell[1],13,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2) MMI_Init_station(MIS_AOI,stations_array[11],4,Init_station_positions[11],stationDwell[1],12,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2) MMI_Init_station(MIS_AOI,stations_array[12],4,Init_station_positions[12],30000,13,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[------------------------------------
Roller Load
------------------------------------
]]>
</Comment>
<Text>
<![CDATA[MMI_Init_station(MIS_AOI,stations_array[13],6,Init_station_positions[13],0,14,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,1)MMI_Init_station(MIS_AOI,stations_array[14],6,Init_station_positions[14],stationDwell[2],15,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[------------------------------------
Pin Press
--------------------------------------
]]>
</Comment>
<Text>
<![CDATA[MMI_Init_station(MIS_AOI,stations_array[15],6,Init_station_positions[15],stationDwell[15],16,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2)MMI_Init_station(MIS_AOI,stations_array[16],6,Init_station_positions[16],stationDwell[16],17,MM_Global_Velocity,MM_Global_Acc,MMI_DIRECTION_FORWARD,2);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[----------------------------------------
Pin Inspection
Pre, 1-3
--------------------------------------
]]>
</Comment>
<Text>
<![CDATA[MMI_Init_station(MIS_AOI,stations_array[17],6,Init_station_positions[17],stationDwell[17],18,0.5,0.75,MMI_DIRECTION_FORWARD,2)MMI_Init_station(MIS_AOI,stations_array[18],6,Init_station_positions[18],stationDwell[18],19,0.5,0.75,MMI_DIRECTION_BIDIRECTIONAL,2)MMI_Init_station(MIS_AOI,stations_array[19],6,Init_station_positions[19],stationDwell[19],20,0.5,0.75,MMI_DIRECTION_BIDIRECTIONAL,2)MMI_Init_station(MIS_AOI,stations_array[20],6,Init_station_positions[20],stationDwell[20],21,0.5,0.75,MMI_DIRECTION_BIDIRECTIONAL,2);]]>
</Text>
