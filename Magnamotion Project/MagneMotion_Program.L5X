<Routine Name="Main_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(S:FS)MOV(300000,GeneralTimers[0].PRE)MOV(1200000,GeneralTimers[1].PRE)MOV(500,GeneralTimers[2].PRE)MOV(500,GeneralTimers[3].PRE)MOV(10000,GeneralTimers[4].PRE)MOV(150000,GeneralTimers[5].PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(PalletsatCleanout) XIC(\System.Guards.Zone1.AllDoorsClosedLocked) XIC(System.Zone1.AllHome.Req) ,XIC(System.Zone1.Manual.Mode) [XIC(\System.Mold1_RecipeChange_OS) ,XIC(\System.Mold2_RecipeChange_OS) ] XIC(\System.Pallets_Empty) ]ONS(magnemotion_ons.15)[[XIO(confirm_Pallet_cleanout) XIO(CleanoutPallets) XIO(Reset_Magnemotion_Pallets) XIO(Recovering_Pallets) GEQ(vehicles_in_path[3],Pallets_In_System_Minus2) ,[XIC(\System.Mold1_RecipeChange_OS) ,XIC(\System.Mold2_RecipeChange_OS) ] ] OTL(Recovering_Pallets) ,[NEQ(vehicles_in_path[3],0) XIO(confirm_Pallet_cleanout) ,[XIC(\System.Mold1_RecipeChange_OS) ,XIC(\System.Mold2_RecipeChange_OS) ] ] OTL(Reset_Magnemotion_Pallets) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(System.Zone1.Cycle.Mode)XIO(\System.Pallets_Empty)TON(GeneralTimers[1],?,?)XIC(GeneralTimers[1].DN)ONS(System.Ons.16)OTL(Cold_Modules_In_Automation);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Set Cleanout bit for Magnemotion pallets to be sent to cleanout position]]>
</Comment>
<Text>
<![CDATA[[[XIC(System.Zone1.AllHome.Req) XIC(Cold_Modules_In_Automation) ,XIC(MagneMotion_Pallet_Blocked) ONS(magnemotion_ons.4) ,XIC(MMI_vehicle_alarms[a].AlarmPresent) ONS(magnemotion_ons.5) ,GRT(\Alarms.MagneMotion.Active[0],1) ONS(magnemotion_ons.11) ,GRT(\Alarms.MagneMotion.Active[1],1) ONS(magnemotion_ons.12) ] ,XIC(System.Zone1.Manual.Mode) [XIC(\System.Mold1_RecipeChange_OS) ,XIC(\System.Mold2_RecipeChange_OS) ] XIO(\System.Pallets_Empty) ,XIO(System.PowerOn) TON(GeneralTimers[0],?,?) XIC(GeneralTimers[0].DN) ,XIO(System.Zone1.Cycle.Mode) XIC(\Alarms.MagneMotion_Vehicle_Fault) ONS(magnemotion_ons.0) ,XIC(S:FS) ]OTL(CleanoutPallets);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[SUB(Pallets_In_System,1,Pallets_In_System_Minus1)SUB(Pallets_In_System,2,Pallets_In_System_Minus2);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[GEQ(vehicles_in_path[3],Pallets_In_System_Minus2)XIO(PalletsatCleanout)OTU(CleanoutPallets)ONS(magnemotion_ons.28)MOV(1,Confirm_Cleanout_Test);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[MOV(15000,GeneralTimers[6].PRE);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQU(Confirm_Cleanout_Test,1)TON(GeneralTimers[6],?,?)XIO(GeneralTimers[6].DN)OTE(confirm_Pallet_cleanout);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(GeneralTimers[6].DN)RES(GeneralTimers[6]);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[GEQ(vehicles_in_path[3],Pallets_In_System_Minus2)ONS(magnemotion_ons.3)OTL(PalletsatCleanout);]]>
</Text>
</Rung>
