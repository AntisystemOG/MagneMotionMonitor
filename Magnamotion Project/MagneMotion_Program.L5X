<![CDATA[CPT(Vehicles_at_Molds,vehicles_in_path[2] + vehicles_in_path[4]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[EQU(Vehicles_at_Molds,Pallets_In_System)OTU(PalletsatCleanout)MOV(0,Confirm_Cleanout_Test);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Set recovery bit for light show when pallet system is homing ]]>
</Comment>
<Text>
<![CDATA[[XIC(Recovering_Pallets) [EQU(Vehicles_at_Molds,Vehicles_Indentified) ONS(magnemotion_ons.6) ADD(Homing_Pallets,1,Homing_Pallets) ,NEQ(Vehicles_at_Molds,Vehicles_Indentified) ONS(magnemotion_ons.7) ADD(Homing_Pallets,1,Homing_Pallets) ] ,XIC(MagneMotion_Ready) GRT(Vehicles_at_Molds,0) XIO(\Alarms.MagneMotion_Vehicle_Fault) XIO(\Alarms.MagneMotion_Motor_Fault) XIO(Reset_Magnemotion_Pallets) CLR(Homing_Pallets) OTU(Recovering_Pallets) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(System.PowerAndAirOn)XIO(System.Zone1.Cycle.Mode)XIO(System.Zone1.ResetPB)[[XIC(CleanoutPallets) [XIC(System.Zone1.AllHome.Mode) ,XIO(MagneMotion_Ready) ] ,XIC(Recovering_Pallets) ] ONS(magnemotion_ons.1) ,[XIO(Cold_Modules_In_Automation) XIC(System.Zone1.AllHome.Mode) XIC(Reset_Magnemotion_Pallets) ,XIC(Reset_Magnemotion_Pallets_PB) ] XIC(\System.Guards.Zone1.AllDoorsClosedLocked) ONS(magnemotion_ons.2) ]MOV(10,cold_start_service.step)MOV(0,vehicles)[OTU(Reset_Magnemotion_Pallets) ,OTL(Recovering_Pallets) ]OTU(Reset_Magnemotion_Pallets_PB);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIC(Reset_Magnemotion_Pallets_PB) ONS(magnemotion2_ons.3) ,XIC(confirm_cleanout_PB) GEQ(vehicles_in_path[3],Pallets_In_System_Minus2) ONS(magnemotion2_ons.4) ]OTU(CleanoutPallets);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Recovering_Pallets)TON(GeneralTimers[5],?,?)XIC(GeneralTimers[5].DN)OTU(Recovering_Pallets);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Clear Latched Memory if it gets stuck on. (Using other recovery memories)]]>
</Comment>
<Text>
<![CDATA[XIO(System.Zone1.Cycle.Mode)XIC(Reset_Magnemotion_Pallets)XIO(CleanoutPallets)XIO(Recovering_Pallets)EQU(vehicles_in_path[3],0)EQU(vehicles_in_path[6],0)ONS(magnemotion_ons.14)OTU(Reset_Magnemotion_Pallets);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Clear Pallet data on HMI confirmation of cleanout]]>
</Comment>
<Text>
<![CDATA[[XIC(confirm_cleanout_PB) ,GEQ(vehicles_in_path[3],Pallets_In_System_Minus2) XIC(System.Reset) ,XIC(System.Manual.Mode) CMP((vehicles_in_path[2]+vehicles_in_path[4])= Pallets_In_System) ONS(magnemotion_ons.13) ]COP(Pallet[0],vehicle_mgr_array[0].Pallet,1)COP(Pallet[0],vehicle_mgr_array[1].Pallet,1)COP(Pallet[0],vehicle_mgr_array[2].Pallet,1)COP(Pallet[0],vehicle_mgr_array[3].Pallet,1)COP(Pallet[0],vehicle_mgr_array[4].Pallet,1)COP(Pallet[0],vehicle_mgr_array[5].Pallet,1)COP(Pallet[0],vehicle_mgr_array[6].Pallet,1)COP(Pallet[0],vehicle_mgr_array[7].Pallet,1)COP(Pallet[0],vehicle_mgr_array[8].Pallet,1)COP(Pallet[0],vehicle_mgr_array[9].Pallet,1)COP(Pallet[0],vehicle_mgr_array[10].Pallet,1)COP(Pallet[0],vehicle_mgr_array[11].Pallet,1)COP(Pallet[0],vehicle_mgr_array[12].Pallet,1)COP(Pallet[0],vehicle_mgr_array[13].Pallet,1)COP(Pallet[0],vehicle_mgr_array[14].Pallet,1)COP(Pallet[0],vehicle_mgr_array[15].Pallet,1)COP(Pallet[0],vehicle_mgr_array[16].Pallet,1)COP(Pallet[0],vehicle_mgr_array[17].Pallet,1)COP(Pallet[0],vehicle_mgr_array[18].Pallet,1)COP(Pallet[0],vehicle_mgr_array[19].Pallet,1)COP(Pallet[0],vehicle_mgr_array[20].Pallet,1)COP(Pallet[0],vehicle_mgr_array[21].Pallet,1)COP(Pallet[0],vehicle_mgr_array[22].Pallet,1)COP(Pallet[0],vehicle_mgr_array[23].Pallet,1)COP(Pallet[0],vehicle_mgr_array[24].Pallet,1)OTU(confirm_cleanout_PB)MOV(2,Confirm_Cleanout_Test)OTU(confirm_Pallet_cleanout)OTU(Cold_Modules_In_Automation);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIO(System.Zone1.Cycle.Mode) ONS(magnemotion_ons.8) ,XIO(\System.Guards.Zone1.AllDoorsClosedLocked) ONS(magnemotion_ons.9) ]OTL(pause_pallets);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(System.Zone1.Cycle.Mode)ONS(magnemotion_ons.10)OTL(resume_pallets);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(hlc_link_status)EQU(msg_service_path_cmd_step,10)[XIC(pause_pallets) [JSR(next_command_count,0,cold_start_service.command_count) ,MMI_Format_Path_Command(MFPC_AOI,0,MMI_SUSPEND_CMD,cold_start_service.command_count,path_cmd) MOV(20,msg_service_path_cmd_step) ] OTU(pause_pallets) ,XIC(resume_pallets) [JSR(next_command_count,0,cold_start_service.command_count) ,MMI_Format_Path_Command(MFPC_AOI,0,MMI_RESUME_CMD,cold_start_service.command_count,path_cmd) MOV(20,msg_service_path_cmd_step) ] OTU(resume_pallets) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[When at step 20 and HLC link is up and path cmd msg service is available for work, format a reset command in path_cmd tag.
Set path_id to zero for all paths, reset command, active flag so HLC acts on this single path cmd entry.
use next_command_count routine to get a new command count and store in cold_start_service.  Store command count in path_cmd
Set the msg_service_path_cmd_step to 20 to let the msg service do the msg for us.
Set up the cold start service timer for 10 seconds so we can wait for path command completion or timeout so we can retry.
Go to next step 30
]]>
</Comment>
<Text>
<![CDATA[EQU(cold_start_service.step,20)XIC(hlc_link_status)EQU(msg_service_path_cmd_step,10)[JSR(next_command_count,0,cold_start_service.command_count) ,MMI_Format_Path_Command(MFPC_AOI,0,MMI_RESET_CMD,cold_start_service.command_count,path_cmd) MOV(20,msg_service_path_cmd_step) ,MOV(120000,cold_start_service.timer.PRE) RES(cold_start_service.timer) MOV(25,cold_start_service.step) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main_Routine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Main_Control,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(simulateMachine)JSR(Init_Dwell,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Position_Edits,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(R000_Status,0)JSR(R002_Recipe,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(cold_start_service,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(msg_service,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[JSR(hlc_link_monitor,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[JSR(station_processing,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[FOR(station_mgr,s,1,max_station_id,1);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[FOR(vehicle_mgr,v,1,max_vehicle_id,1);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[FOR(vehicle_alarm_mgr,a,1,max_vehicle_id,1);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[FOR(motor_alarm_mgr,path,1,max_path_id,1);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[JSR(pallet_data,0);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[JSR(vehicle_loc,0);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(System.Reset)OTU(\Alarms.MagneMotion_Vehicle_Fault)OTU(\Alarms.MagneMotion_Motor_Fault);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="motor_alarm_mgr" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[if motor_id >= 64 THEN]]>
</Line>
<Line Number="1">
<![CDATA[	COP(MMI_motor_alarm[0],MMI_motor_alarm[1],64);]]>
</Line>
<Line Number="2">
<![CDATA[end_if;]]>
</Line>
<Line Number="3">
<![CDATA[	for motor := 1 to max_motor_id Do]]>
</Line>
<Line Number="4">
<![CDATA[		motor_id := (path * motor)+1;]]>
</Line>
<Line Number="5">
<![CDATA[		if motor_id < 64 THEN]]>
</Line>
<Line Number="6">
<![CDATA[			MMI_motor_alarm[motor_id].Not_Operational :=	MMI_path_ml_faults_status[path,motor].Motor_Overall.0;]]>
</Line>
<Line Number="7">
<![CDATA[			MMI_motor_alarm[motor_id].In_Config_Mode :=	MMI_path_ml_faults_status[path,motor].Motor_Overall.1;]]>
</Line>
<Line Number="8">
<![CDATA[			MMI_motor_alarm[motor_id].In_Diag_Mode :=	MMI_path_ml_faults_status[path,motor].Motor_Overall.2;]]>
</Line>
<Line Number="9">
<![CDATA[			MMI_motor_alarm[motor_id].Suspended :=	MMI_path_ml_faults_status[path,motor].Motor_Overall.3;]]>
</Line>
<Line Number="10">
<![CDATA[			MMI_motor_alarm[motor_id].Stopped :=	MMI_path_ml_faults_status[path,motor].Motor_Overall.4;]]>
</Line>
<Line Number="11">
<![CDATA[			MMI_motor_alarm[motor_id].Not_Responding :=	MMI_path_ml_faults_status[path,motor].Motor_Overall.7;]]>
</Line>
<Line Number="12">
<![CDATA[		end_if;]]>
</Line>
<Line Number="13">
<![CDATA[		]]>
</Line>
<Line Number="14">
<![CDATA[		if MMI_motor_alarm[motor_id].Not_Operational OR MMI_motor_alarm[motor_id].In_Config_Mode OR MMI_motor_alarm[motor_id].In_Diag_Mode OR MMI_motor_alarm[motor_id].Not_Responding THEN]]>
</Line>
<Line Number="15">
<![CDATA[			if motor_id < 8 or motor_id > 8 THEN]]>
</Line>
<Line Number="16">
<![CDATA[			MMI_motor_alarm[motor_id].Alarm_Present := 1;]]>
</Line>
<Line Number="17">
<![CDATA[			end_if;]]>
</Line>
<Line Number="18">
<![CDATA[		else]]>
</Line>
<Line Number="19">
<![CDATA[			MMI_motor_alarm[motor_id].Alarm_Present := 0;]]>
</Line>
<Line Number="20">
<![CDATA[		end_if;]]>
</Line>
<Line Number="21">
<![CDATA[	end_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="msg_service" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[PATH COMMAND Msg Service -- At Step 10, do nothing til logic outside here sets up a path command for us to work on.
Said logic will check if we're free for work by seeing if we're at step 10 and if so it will populate path_cmd and set our step to 20 to kick 
this routine into action!]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_path_cmd_step,10)NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[We've got a path_cmd to work on, reset our retry timer and go to step 30]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_path_cmd_step,20)RES(msg_service_path_cmd_timer)MOV(30,msg_service_path_cmd_step);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[When the msg_path_cmd MSG instruction is NOT busy (shouldn't be, but I/O is done outside PLC scan, so it's best to check), Trigger the MSG and go to step 40]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_path_cmd_step,30)XIO(msg_path_cmd.ST)[MSG(msg_path_cmd) ,MOV(40,msg_service_path_cmd_step) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Store the path_cmd.path_id field used in tmp_int.  When tmp_int is a zero meaning all paths, set tmp_int to a 1 -- we can just check
 path #1 and if it reports command accepted, we know the HLC acted on all paths.
When tmp_int is non-zero meaning a specific path, we'll check for just that path's completion status of the command.
If command was received by specific path at index tmp_int or path 1 if all paths were acted on, we're done!  go back to step 10 to wait for another
command to be scheduled by logic outside here.]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_path_cmd_step,40)MOV(path_cmd.path_id,tmp_int)[EQU(tmp_int,0) MOV(1,tmp_int) ,EQU(MMI_path_command_status[tmp_int].last_command_received_count,path_cmd.command_count) MOV(10,msg_service_path_cmd_step) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOV(250,msg_service_path_cmd_timer.PRE);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Pet our retry timer every scan]]>
</Comment>
<Text>
<![CDATA[TON(msg_service_path_cmd_timer,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[If our step is 30 or more AND our retry timer expires, go back to step 20 and try again.
This will have us try over and over in the case of a network interruption etc.]]>
</Comment>
<Text>
<![CDATA[GEQ(msg_service_path_cmd_step,30)XIC(msg_service_path_cmd_timer.DN)ADD(1,msg_path_cmd_timeout_count,msg_path_cmd_timeout_count)MOV(20,msg_service_path_cmd_step);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[POSITION ORDER Msg Service -- At Step 10, do nothing til logic outside here sets up a position order for us to work on
This part of the routine is the same as the logic above that handles path commands, but handles vehicle position orders instead.
The logic is structured much the same.]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_move_to_pos_step,10)NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQU(msg_service_move_to_pos_step,20)RES(msg_service_move_to_pos_timer)MOV(30,msg_service_move_to_pos_step);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(msg_service_move_to_pos_step,30)XIO(msg_position_order.ST)[MSG(msg_position_order) ,MOV(40,msg_service_move_to_pos_step) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[For convenience since position_order is an array that can do mulitple vehicles (this logic only uses position_order[0] to do
multiple vehicles in succession) after the order is confirmed for all possible vehicle orders stored in position_order, clear the 
active_flag for each entry as convenience so the logic that uses this outiside of here can assume all active_flags for each position_order
entry is cleared so a single vehicle can be ordered at position_order[0] or mulitples -- works both ways.]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_move_to_pos_step,40)[MOV(position_order[0].vehicle_id,tmp_int) ,EQU(MMI_vehicle_order_status[tmp_int].last_order_number_received,position_order[0].order_number) MOV(0,i) MOV(50,msg_service_move_to_pos_step) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Clear the active flag for all 8 entries in the position_order MSG source area
Logic outside here chooses which entries the HLC should pay attention to in
the MSG content by setting active_flag for a particular element.]]>
</Comment>
<Text>
<![CDATA[LBL(loop2)EQU(msg_service_move_to_pos_step,50)[MOV(0,position_order[i].active_flag) ,LES(i,7) ADD(i,1,i) JMP(loop2) ,MOV(10,msg_service_move_to_pos_step) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[MOV(250,msg_service_move_to_pos_timer.PRE);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[TON(msg_service_move_to_pos_timer,?,?);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[GEQ(msg_service_move_to_pos_step,30)XIC(msg_service_move_to_pos_timer.DN)ADD(1,msg_position_order_timeout_count,msg_position_order_timeout_count)MOV(20,msg_service_move_to_pos_step);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Terminus COMMAND Msg Service -- At Step 10, do nothing til logic outside here sets up a path command for us to work on.
Said logic will check if we're free for work by seeing if we're at step 10 and if so it will populate path_cmd and set our step to 20 to kick 
this routine into action!]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_terminus_cmd_step,10)NOP();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[We've got a terminus_cmd to work on, reset our retry timer and go to step 30]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_terminus_cmd_step,20)RES(msg_service_terminus_cmd_timer)MOV(30,msg_service_terminus_cmd_step);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[When the msg_terminus_node_cmd MSG instruction is NOT busy (shouldn't be, but I/O is done outside PLC scan, so it's best to check), Trigger the MSG and go to step 40]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_terminus_cmd_step,30)XIO(msg_terminus_node_cmd.ST)[MSG(msg_terminus_node_cmd) ,MOV(40,msg_service_terminus_cmd_step) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Store the terminus_cmd.node_id field used in tmp_int.
When tmp_int is non-zero meaning a specific path, we'll check for just that path's completion status of the command.
If command was received by specific path at index tmp_int, we're done!  Go back to step 10 to wait for another
command to be scheduled by logic outside here.]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_terminus_cmd_step,40)MOV(terminus_cmd[0].node_id,tmp_int)EQU(MMI_node_command_status[tmp_int].last_command_received_count,terminus_cmd[0].command_count)MOV(0,terminus_cmd[0].active_flag)MOV(10,msg_service_terminus_cmd_step);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[MOV(250,msg_service_terminus_cmd_timer.PRE);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[TON(msg_service_terminus_cmd_timer,?,?);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[If our step is 30 or more AND our retry timer expires, go back to step 20 and try again.
This will have us try over and over in the case of a network interruption etc.]]>
</Comment>
<Text>
<![CDATA[GEQ(msg_service_terminus_cmd_step,30)XIC(msg_service_terminus_cmd_timer.DN)ADD(1,msg_terminus_cmd_timeout_count,msg_terminus_cmd_timeout_count)MOV(20,msg_service_terminus_cmd_step);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Digital IO CommandMsg Service -- At Step 10, do nothing til logic outside here sets up a DIO command for us to work on.
Said logic will check if we're free for work by seeing if we're at step 10 and if so it will populate MMI_node_controller_DIO_command and set our step to 20 to kick 
this routine into action!]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_dio_cmd_step,10)NOP();]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[We've got a digital IO command to work on, reset our retry timer and go to step 30]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_dio_cmd_step,20)RES(msg_service_dio_cmd_timer)MOV(30,msg_service_dio_cmd_step);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[When the msg_set_outputs MSG instruction is NOT busy (shouldn't be, but I/O is done outside PLC scan, so it's best to check), Trigger the MSG and go to step 40]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_dio_cmd_step,30)XIO(msg_set_outputs.ST)[MSG(msg_set_outputs) ,MOV(40,msg_service_dio_cmd_step) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Store the node controller ID field used in tmp_int.
If command was received by specific NC at index tmp_int, we're done!  go back to step 10 to wait for another
command to be scheduled by logic outside here.]]>
</Comment>
<Text>
<![CDATA[EQU(msg_service_dio_cmd_step,40)MOV(MMI_node_controller_dio_command.node_controller_id,tmp_int)EQU(MMI_node_controller_cmd_status[tmp_int].last_command_received_count,MMI_node_controller_dio_command.command_count)MOV(0,MMI_node_controller_dio_command.active_flag)MOV(10,msg_service_dio_cmd_step);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[MOV(250,msg_service_dio_cmd_timer.PRE);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Pet our retry timer every scan]]>
</Comment>
<Text>
<![CDATA[TON(msg_service_dio_cmd_timer,?,?);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[If our step is 30 or more AND our retry timer expires, go back to step 20 and try again.
This will have us try over and over in the case of a network interruption etc.]]>
</Comment>
<Text>
<![CDATA[GEQ(msg_service_dio_cmd_step,30)XIC(msg_service_dio_cmd_timer.DN)ADD(1,msg_dio_cmd_timeout_count,msg_dio_cmd_timeout_count)MOV(20,msg_service_dio_cmd_step);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="next_command_count" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[convenience routine to increment a DINT master_command_count each time a new transaction is to be done with the HLC.
This wraps the count at one million back to one.]]>
</Comment>
<Text>
<![CDATA[LEQ(master_command_count,1000000)ADD(master_command_count,1,master_command_count);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GRT(master_command_count,1000000)MOV(1,master_command_count);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[RET(master_command_count);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="pallet_data" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Check all Pallet data and create a count for how many modules from each mold are active in the automation]]>
</Comment>
<Text>
<![CDATA[LBL(pall)[EQU(pal,0) CLR(modules_from_mold[1]) CLR(modules_from_mold[2]) CLR(Modules_In_Automation) ,NEQ(vehicle_mgr_array[pal].Pallet.MoldStation,0) MOV(vehicle_mgr_array[pal].Pallet.MoldStation,mold) ADD(modules_from_mold[mold],1,modules_from_mold[mold]) ,XIC(vehicle_mgr_array[pal].Pallet.ModulePresent) ADD(Modules_In_Automation,1,Modules_In_Automation) ,GRT(vehicle_mgr_array[pal].arrived_station_id,0) MOV(vehicle_mgr_array[pal].arrived_station_id,vehicle_mgr_array[pal].Pallet.Location) ,LES(pal,24) ADD(pal,1,pal) JMP(pall) ,MOV(0,pal) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
